# pylint config for this repository. Two defaults are relaxed for data-shaped code, where a
# record projected from an API has as many fields as the API does:
# 1. Design metrics: max-locals is 40, not 15 (a top-level command function threads that many
#    named values by nature; calibrated against curator's before settling on the number). The
#    other limits stay low enough to catch a function that has genuinely grown out of control;
#    pylint found a real dangling-variable bug here, on a path the tests do not execute.
# 2. Test docstrings aren't required: a name like test_two_users_finishing_counts_two is already
#    a sentence. Module, class and production-function docstrings still are.

[MESSAGES CONTROL]
# Duplicate-code flags the shared arrange/act shape every test suite has across test modules.
disable = duplicate-code

[BASIC]
no-docstring-rgx = ^(_|test_)

[DESIGN]
max-args = 8
max-positional-arguments = 8
max-locals = 40
max-attributes = 20
max-branches = 15
max-statements = 60
max-returns = 20

[FORMAT]
max-line-length = 120
