# pylint configuration for this repository.
#
# Only two things are adjusted, both because the defaults are tuned for
# application code rather than for what lives here.
#
# 1. Design metrics. The defaults (5 arguments, 15 locals, 7 attributes) are
#    tight for data-shaped code: a record projected from an API has as many
#    fields as the API has, and splitting a validated pipeline into smaller
#    functions purely to satisfy a counter makes it harder to read, not easier.
#    max-locals is 40 rather than the default 15 because a top-level command
#    function threads that many named values between steps by nature; three
#    helpers were extracted from curator's before settling on the number, and the
#    count barely moved. The other limits are still low enough to catch a
#    function that has genuinely grown out of control -- and pylint earns its
#    place here regardless: it found a dangling variable reference on a path the
#    tests do not execute.
# 2. Test docstrings. A test method named test_two_users_finishing_counts_two is
#    already a sentence; requiring a second one underneath it adds no information.
#    Module, class and production-function docstrings are still required.

[MESSAGES CONTROL]
# Duplicate-code compares test modules against each other and flags the shared
# arrange/act shape that every test suite has.
disable = duplicate-code

[BASIC]
no-docstring-rgx = ^(_|test_)

[DESIGN]
max-args = 8
max-positional-arguments = 8
max-locals = 40
max-attributes = 20
max-branches = 15
max-statements = 60
max-returns = 20

[FORMAT]
max-line-length = 120
