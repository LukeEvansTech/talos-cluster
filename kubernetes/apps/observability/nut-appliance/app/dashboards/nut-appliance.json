          "editorMode": "code",
          "expr": "time() - node_boot_time_seconds{job=\"nut-appliance-node\"}",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Uptime",
      "type": "stat"
