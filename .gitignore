!.claude/settings.json
# settings.json references hooks by path, and their `|| true` turns a missing script into silence,
# not an error, so they must stay tracked. The directory itself needs the negation: git does not
# descend into an excluded directory, so negating a file inside one never matches.
!.claude/hooks/
.playwright-mcp/
.DS_Store
Thumbs.db
CLAUDE.md

# kubectl cache (kubeconfig lives in-repo, so kubectl drops its cache here)
.kube/

__pycache__/
*.pyc

# Local-only mise config, carries INTERNAL_DOMAIN_RE for the identifier guard; never commit it.
.mise.local.toml
